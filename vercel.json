{ 
  "redirects": [
    {
      "source": "/room1",
      "destination": "/?id=room1",
      "permanent": true
    },
    {
      "source": "/room2",
      "destination": "/?id=room2",
      "permanent": true
    },
    {
      "source": "/room3",
      "destination": "/?id=room3",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
